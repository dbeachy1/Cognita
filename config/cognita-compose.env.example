# Copy to the deployment's environment file, restrict it to owner read/write
# (chmod 600), and replace every placeholder before starting the service.
#
# Compose reads this file to configure a deployment and its host storage roots.

# A short identifier for this Cognita deployment.
COGNITA_RELEASE_TARGET=main

# Image version used by Compose. Update this to the release you install.
COGNITA_VERSION=15.1.2

# Explicit host roots for configuration, documents, database, workspace and
# downloaded model data. Choose locations with enough space for your workload.
COGNITA_CONFIG_ROOT=/data/cognita/config
COGNITA_PROJECTS_ROOT=/data/cognita/projects
COGNITA_POSTGRES_DATA_ROOT=/data/cognita/postgres
COGNITA_WORKSPACE_DATA_ROOT=/data/cognita/workspaces
COGNITA_TRANSFER_STAGING_ROOT=/data/cognita/transfers
COGNITA_SECRETS_ROOT=/data/cognita/secrets
COGNITA_MODEL_CACHE_ROOT=/data/cognita/models
COGNITA_TOOLBOX_IMAGE_CACHE_ROOT=/data/cognita/toolbox-cache

# Numeric owner of the configuration, PostgreSQL, model, and transfer roots.
# Set these to the account that owns the host roots; check with `id -u`/`id -g`.
COGNITA_SERVICE_UID=1000
COGNITA_SERVICE_GID=1000
# Numeric group owning /dev/kvm. On Linux, find it with: stat -c '%g' /dev/kvm
# The runtime receives this one supplementary group only; capabilities remain
# fully dropped and privileged mode is prohibited.
COGNITA_KVM_GID=36

# Host ports for the MCP and Admin services. Keep Admin on a trusted network;
# PostgreSQL and the workspace runtime do not publish host ports.
COGNITA_MCP_HOST_PORT=8675
COGNITA_MCP_BIND_ADDRESS=127.0.0.1
COGNITA_ADMIN_HOST_PORT=8676
COGNITA_ADMIN_BIND_ADDRESS=0.0.0.0

# CPU is the default. Select an acceleration profile in the Compose command
# after confirming its runtime is available on the host.
# GPU/OCR policy is persisted in the Admin-owned acceleration.yaml.
COGNITA_VIDEO_GID=44
COGNITA_RENDER_GID=109

# A fresh installation creates matching owner-only postgres.password and
# postgres.dsn files beneath COGNITA_SECRETS_ROOT without printing the
# generated password; neither value belongs in this file.
# If cognita.yaml enables Admin TLS, create owner-only admin_tls_certfile and
# admin_tls_keyfile beneath the same root. Compose mounts those exact files
# read-only at /run/secrets/admin_tls_certfile and
# /run/secrets/admin_tls_keyfile; do not mount a host certificate directory
# into the container or leave the configured paths host-specific.
# When Admin TLS is disabled, create owner-only EMPTY files at those two paths
# anyway -- Compose resolves every declared file-backed secret before startup --
# and leave the TLS settings in cognita.yaml empty so Admin stays on HTTP.
